-- One-time codes bind an Android recorder to one existing project session.
CREATE TABLE device_pairing_codes (
    code_hash TEXT PRIMARY KEY,
    owner_subject TEXT NOT NULL,
    project_id TEXT NOT NULL REFERENCES projects(id),
    session_id TEXT NOT NULL REFERENCES sessions(id),
    expires_at TEXT NOT NULL,
    consumed_at TEXT,
    created_at TEXT NOT NULL
);

CREATE INDEX idx_device_pairing_expiry
    ON device_pairing_codes(expires_at, consumed_at);

-- Device credentials never store the bearer token itself and cannot traverse another project.
CREATE TABLE device_credentials (
    token_hash TEXT PRIMARY KEY,
    owner_subject TEXT NOT NULL,
    project_id TEXT NOT NULL REFERENCES projects(id),
    session_id TEXT NOT NULL REFERENCES sessions(id),
    device_id TEXT NOT NULL,
    expires_at TEXT NOT NULL,
    revoked_at TEXT,
    created_at TEXT NOT NULL,
    last_used_at TEXT NOT NULL
);

CREATE INDEX idx_device_credentials_scope
    ON device_credentials(owner_subject, project_id, session_id, device_id, expires_at);
