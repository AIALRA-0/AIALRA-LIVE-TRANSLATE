# 核心服务只监听本机，局域网手机接入时由用户显式改为 0.0.0.0:8787
AIALRA_BIND=127.0.0.1:8787

# 界面按服务端实际位置显示，不把 VPS 处理误写为本机处理
AIALRA_DEPLOYMENT_MODE=local
AIALRA_PROCESSING_LOCATION=本机处理

# GPU Agent 从持久队列领取任务，本机模式使用同一个核心地址
AIALRA_GPU_GATEWAY_URL=http://127.0.0.1:8787
AIALRA_MODEL_WORKER_URL=http://127.0.0.1:8790

# 真实令牌不写入本文件，安装脚本会使用 Windows DPAPI 保存
AIALRA_WORKER_TOKEN=
AIALRA_WORKER_TOKEN_SHA256=

# 本地数据目录保存 SQLite、音频块、课程材料和导出
AIALRA_DATA_DIR=./data
AIALRA_LEGACY_OWNER_SUBJECT=

# 本地解释模型使用现有 Ollama；模型名可按本机清单替换
AIALRA_OLLAMA_URL=http://127.0.0.1:11434
AIALRA_OLLAMA_MODEL=qwen2.5:3b-instruct
# Apply this to the Ollama server process so translation can continue during a long explanation.
OLLAMA_NUM_PARALLEL=2

# 本地 ASR 默认使用较小模型保证实时性，large-v3 只有通过本机延迟和显存基准后才切换
AIALRA_ASR_MODEL=small
AIALRA_ASR_DEVICE=cpu
AIALRA_ASR_COMPUTE_TYPE=int8
# The i9-13900K production benchmark selected 12; remeasure before changing hosts.
AIALRA_ASR_CPU_THREADS=12
AIALRA_LLM_DEVICE=cuda

# 每完成这些稳定字幕段后触发一次证据关联讲解，设置为 0 会回退到默认值 5
AIALRA_EXPLAIN_EVERY_SEGMENTS=5

# 云端出口保持关闭；打开后仍需会话级策略允许
LOCAL_ONLY=true
CLOUD_TEXT_ALLOWED=false
CLOUD_MULTIMODAL_ALLOWED=false

# DingTalk 凭据只由后端环境读取，示例文件不包含任何真实值
DINGTALK_ACCESS_TOKEN=
DINGTALK_API_BASE=https://api.dingtalk.com

# A1 录音控制需要团队码和操作者用户 ID，实际字段以企业应用授权结果为准
DINGTALK_TEAM_CODE=
DINGTALK_USER_ID=

# ReadWeave ETAPI 仅由 Core 读取，令牌不得进入浏览器或 Git
AIALRA_READWEAVE_BASE_URL=
AIALRA_READWEAVE_ETAPI_TOKEN=
AIALRA_READWEAVE_ROOT_NOTE_ID=root
AIALRA_READWEAVE_PUBLIC_URL=
