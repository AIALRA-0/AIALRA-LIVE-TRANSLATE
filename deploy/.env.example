# Public hostname and loopback port are deployment-time values, not source defaults.
LIVE_SITE_HOST=translate.example.com
AIALRA_PORT=13150

# Persistent data stays outside immutable release directories.
AIALRA_DATA_PATH=/srv/aialra/data/live-translate
AIALRA_MODEL_PATH=/srv/aialra/data/live-translate-models
AIALRA_OLLAMA_PATH=/srv/aialra/data/live-translate-ollama

# CPU-safe VPS defaults. A CUDA worker can override these on a GPU host.
AIALRA_ASR_MODEL=tiny
AIALRA_ASR_DEVICE=cpu
AIALRA_ASR_COMPUTE_TYPE=int8
AIALRA_OLLAMA_MODEL=qwen2.5:1.5b-instruct
AIALRA_EXPLAIN_EVERY_SEGMENTS=5

# DingTalk credentials stay in the private deployment environment.
DINGTALK_ACCESS_TOKEN=
DINGTALK_TEAM_CODE=
DINGTALK_USER_ID=
