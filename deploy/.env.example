# Public hostname and loopback port are deployment-time values, not source defaults.
LIVE_SITE_HOST=translate.example.com
AIALRA_PORT=13150
AIALRA_WORKER_GATEWAY_PORT=13151
AIALRA_REQUIRE_AUTH_PROXY_MARKER=true
AIALRA_ALLOWED_ORIGINS=https://live.aialra.online

# Persistent data stays outside immutable release directories.
AIALRA_PLATFORM_ROOT=/opt/example-platform
AIALRA_DATA_PATH=/var/lib/aialra-live-translate
# VPS stores only a SHA-256 digest; the Windows agent keeps the raw token under DPAPI.
AIALRA_WORKER_TOKEN_SHA256=replace-with-64-lowercase-hex-characters
AIALRA_LEGACY_OWNER_SUBJECT=replace-with-stable-authentik-subject

# ReadWeave 与 Core 共享私有容器网络，ETAPI 不经过公网域名
AIALRA_READWEAVE_BASE_URL=http://readweave:8080
AIALRA_READWEAVE_ETAPI_TOKEN=replace-with-server-secret
AIALRA_READWEAVE_ROOT_NOTE_ID=root
AIALRA_READWEAVE_PUBLIC_URL=https://notes.example.com
AIALRA_READWEAVE_CONTAINER=readweave

# Final summaries stay compact so a cold 14B load remains an explicit asynchronous task
AIALRA_SUMMARY_MAX_TOKENS=320
AIALRA_SUMMARY_TIMEOUT_SECONDS=120
AIALRA_SUMMARY_HTTP_TIMEOUT_SECONDS=150

# Shared services are deployment-specific and remain outside the repository.
AIALRA_AUTH_SERVICE=example-auth-gateway.service
AIALRA_CERTBOT_CREDENTIALS=/etc/letsencrypt/cloudflare.ini

# DingTalk credentials stay in the private deployment environment.
DINGTALK_ACCESS_TOKEN=
DINGTALK_TEAM_CODE=
DINGTALK_USER_ID=
