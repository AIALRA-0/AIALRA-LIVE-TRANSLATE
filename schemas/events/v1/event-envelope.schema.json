{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aialra.local/schemas/events/v1/event-envelope.schema.json",
  "title": "AIALRA Event Envelope 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "schema_version",
    "session_id",
    "source_id",
    "sequence",
    "event_type",
    "captured_at_monotonic_ns",
    "captured_at_wall",
    "ingested_at",
    "correlation_id",
    "content_hash",
    "payload"
  ],
  "properties": {
    "event_id": { "type": "string", "format": "uuid" },
    "schema_version": { "const": "1.0.0" },
    "session_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "source_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "sequence": { "type": "integer", "minimum": 0 },
    "event_type": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{1,127}$" },
    "captured_at_monotonic_ns": { "type": "integer", "minimum": 0 },
    "captured_at_wall": { "type": "string", "format": "date-time" },
    "ingested_at": { "type": "string", "format": "date-time" },
    "correlation_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "causation_id": { "type": ["string", "null"], "maxLength": 128 },
    "content_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "payload": { "type": "object" }
  }
}

